      "position": [660, 0]
    },
    {
      "parameters": {
        "url": "http://10.0.10.8:8080/apirest.php/Ticket?range=0-9",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendHeaders": true,
