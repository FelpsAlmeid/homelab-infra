    },
    {
      "parameters": {
        "url": "http://10.0.10.4:11434/api/tags",
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Ollama - tags",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 0],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const z = $('Zabbix - problem.get').first().json;\nconst nb = $('NetBox - devices').first().json;\nconst ini = $('GLPI - initSession').first().json;\nconst tk = $('GLPI - Ticket').all().map(i => i.json);\nconst ol = $('Ollama - tags').first().json;\nreturn [{ json: {\n  zabbix_ok: Array.isArray(z.result),\n  zabbix_problemas: (z.result || []).map(p => `${p.eventid} sev${p.severity} ${p.name}`),\n  zabbix_erro: z.error || null,\n  netbox_ok: typeof nb.count === 'number',\n  netbox_total_devices: nb.count,\n  glpi_sessao_ok: !!ini.session_token,\n  glpi_chamados: tk.filter(t => t.id).map(t => `#${t.id} status ${t.status}`),\n  ollama_modelos: (ol.models || []).map(m => m.name)\n} }];"
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Resumo do teste",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 0]
    }
