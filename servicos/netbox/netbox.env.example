# Trecho de env/netbox.env (somente as variáveis alteradas)
ALLOWED_HOSTS=10.0.10.7 localhost 127.0.0.1
CSRF_TRUSTED_ORIGINS=http://10.0.10.7:8080
# Ao publicar no proxy, acrescente o subdomínio:
# ALLOWED_HOSTS=10.0.10.7 localhost 127.0.0.1 netbox.<seu-dominio>
# CSRF_TRUSTED_ORIGINS=http://10.0.10.7:8080 https://netbox.<seu-dominio>
SECRET_KEY=<SEGREDO>
DB_PASSWORD=<SEGREDO>
