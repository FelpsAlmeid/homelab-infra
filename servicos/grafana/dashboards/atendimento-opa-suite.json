          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH p AS (SELECT $__timeFrom()::timestamptz AS ini, $__timeTo()::timestamptz AS fim),\nj AS (SELECT p.ini - (p.fim - p.ini) AS ini, p.ini AS fim, 0 AS ord FROM p\n      UNION ALL SELECT p.ini, p.fim, 1 FROM p)\nSELECT j.fim AS time, round(100.0 * count(a.id) FILTER (WHERE a.rating >= 4) / nullif(count(a.rating), 0), 1) AS valor\nFROM j LEFT JOIN opa_atendimentos a ON a.data_abertura >= j.ini AND a.data_abertura < j.fim AND a.setor IN ($setor)\nGROUP BY j.fim, j.ord HAVING count(a.rating) > 0\nORDER BY j.ord"
