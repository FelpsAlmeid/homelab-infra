      "transparent": true,
      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;align-items:center;gap:22px;height:100%;padding:6px 8px;border-bottom:3px solid #94C800;\"><img src=\"/public/img/conecta/conecta-fibra-logo-600.png\" alt=\"Conecta Fibra\" style=\"height:46px;flex:none\"/><div style=\"width:1px;align-self:stretch;margin:6px 0;background:rgba(255,255,255,.18)\"></div><div style=\"flex:1;min-width:0\"><div style=\"font-size:22px;font-weight:700;letter-spacing:.2px;line-height:1.2\">Atendimento ao Cliente</div><div style=\"font-size:13px;color:#9AA3AE;margin-top:3px\">Painel executivo · Opa Suite · compare períodos pelo seletor de tempo e filtre setores pelo campo <b>Setor</b></div></div></div>"
