    {
      "id": 2,
      "type": "stat",
      "title": "Dados atualizados há",
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 3
      },
      "transparent": true,
      "description": "Tempo desde a última sincronização com a Opa Suite (n8n, a cada 5 min). Verde até 10 min.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRESQL-NOC}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL-NOC}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT EXTRACT(EPOCH FROM (now() - max(executado_em))) / 60 AS valor FROM opa_sync_log WHERE fluxo = 'opa_sync_atendimentos'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 0,
          "noValue": "sem dados",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#94C800",
                "value": null
              },
              {
                "color": "#F0B05A",
                "value": 10
              },
              {
                "color": "#FF8A7A",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
