    {
      "id": 14,
      "type": "table",
      "title": "Indicadores por setor",
      "description": "Tempo mediano = abertura até encerramento (finalizados). CSAT = % de notas 4 e 5. O setor Agentes Virtuais é o bot.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRESQL-NOC}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL-NOC}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH s AS (\n  SELECT setor, count(*) AS qtd,\n    percentile_cont(0.5) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM (data_encerramento - data_abertura)) / 60)\n      FILTER (WHERE status = 'F' AND data_encerramento IS NOT NULL) AS m,\n    avg(rating) AS nota, count(rating) AS aval,\n    count(*) FILTER (WHERE rating >= 4) AS boas, count(*) FILTER (WHERE fora_horario) AS fora\n  FROM opa_atendimentos WHERE setor IN ($setor) AND $__timeFilter(data_abertura) GROUP BY setor)\nSELECT setor AS \"Setor\", qtd AS \"Atendimentos\",\n  round(100.0 * qtd / sum(qtd) OVER (), 1) AS \"% do total\",\n  CASE WHEN m IS NULL THEN NULL WHEN m < 60 THEN round(m)::int || ' min' WHEN m < 1440 THEN floor(m / 60)::int || 'h' || lpad((round(m)::int % 60)::text, 2, '0') ELSE floor(m / 1440)::int || 'd ' || floor((round(m)::int % 1440) / 60)::int || 'h' END AS \"Tempo mediano\",\n  round(nota::numeric, 2) AS \"Nota média\",\n  round(100.0 * boas / nullif(aval, 0), 0) AS \"CSAT\",\n  aval AS \"Avaliações\",\n  round(100.0 * fora / qtd, 0) AS \"Fora do horário\"\nFROM s ORDER BY qtd DESC"
        }
      ],
