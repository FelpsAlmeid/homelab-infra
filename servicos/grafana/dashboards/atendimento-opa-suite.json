    {
      "id": 4,
      "type": "stat",
      "title": "Atendimentos",
      "description": "Atendimentos abertos no período. A seta compara com o período anterior de mesmo tamanho.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRESQL-NOC}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL-NOC}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH p AS (SELECT $__timeFrom()::timestamptz AS ini, $__timeTo()::timestamptz AS fim),\nj AS (SELECT p.ini - (p.fim - p.ini) AS ini, p.ini AS fim, 0 AS ord FROM p\n      UNION ALL SELECT p.ini, p.fim, 1 FROM p)\nSELECT j.fim AS time, count(a.id) AS valor\nFROM j LEFT JOIN opa_atendimentos a ON a.data_abertura >= j.ini AND a.data_abertura < j.fim AND a.setor IN ($setor)\nGROUP BY j.fim, j.ord HAVING count(a.id) > 0\nORDER BY j.ord"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#94C800"
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": true,
        "percentChangeColorMode": "same_as_value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Resolvidos pelo bot",
      "description": "Parte dos atendimentos finalizados que o agente virtual resolveu sozinho. Considera todos os setores.",
      "gridPos": {
        "x": 4,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRESQL-NOC}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL-NOC}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH p AS (SELECT $__timeFrom()::timestamptz AS ini, $__timeTo()::timestamptz AS fim),\nj AS (SELECT p.ini - (p.fim - p.ini) AS ini, p.ini AS fim, 0 AS ord FROM p\n      UNION ALL SELECT p.ini, p.fim, 1 FROM p)\nSELECT j.fim AS time, round(100.0 * count(a.id) FILTER (WHERE a.setor = 'Agentes Virtuais') / nullif(count(a.id), 0), 1) AS valor\nFROM j LEFT JOIN opa_atendimentos a ON a.data_encerramento >= j.ini AND a.data_encerramento < j.fim AND a.status = 'F'\nGROUP BY j.fim, j.ord HAVING count(a.id) > 0\nORDER BY j.ord"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#18A8E4"
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": true,
        "percentChangeColorMode": "standard"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Tempo mediano",
      "description": "Mediana do tempo entre abertura e encerramento dos atendimentos humanos (sem o bot). A mediana não é distorcida por conversas que ficam dias abertas. Seta verde = mais rápido.",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 4,
        "h": 5
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRESQL-NOC}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL-NOC}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH p AS (SELECT $__timeFrom()::timestamptz AS ini, $__timeTo()::timestamptz AS fim),\nj AS (SELECT p.ini - (p.fim - p.ini) AS ini, p.ini AS fim, 0 AS ord FROM p\n      UNION ALL SELECT p.ini, p.fim, 1 FROM p)\nSELECT j.fim AS time, round((percentile_cont(0.5) WITHIN GROUP (ORDER BY EXTRACT(EPOCH FROM (a.data_encerramento - a.data_abertura)) / 60))::numeric, 0) AS valor\nFROM j LEFT JOIN opa_atendimentos a ON a.data_encerramento >= j.ini AND a.data_encerramento < j.fim AND a.status = 'F' AND a.setor <> 'Agentes Virtuais' AND a.setor IN ($setor)\nGROUP BY j.fim, j.ord HAVING count(a.id) > 0\nORDER BY j.ord"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: min",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#A9DB1E"
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "showPercentChange": true,
        "percentChangeColorMode": "inverted"
      }
    },
    {
