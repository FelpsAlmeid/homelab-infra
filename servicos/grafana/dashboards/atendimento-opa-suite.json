    {
      "id": 16,
      "type": "table",
      "title": "Demanda por dia da semana e hora",
      "description": "Total de atendimentos abertos no período em cada dia da semana e hora (Fortaleza). Quanto mais escuro, maior a demanda — base para dimensionar escala.",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRESQL-NOC}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL-NOC}"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT CASE d WHEN 1 THEN 'Seg' WHEN 2 THEN 'Ter' WHEN 3 THEN 'Qua' WHEN 4 THEN 'Qui' WHEN 5 THEN 'Sex' WHEN 6 THEN 'Sáb' ELSE 'Dom' END AS \"Dia\",\n  count(*) FILTER (WHERE h = 0) AS \"00h\",\n  count(*) FILTER (WHERE h = 1) AS \"01h\",\n  count(*) FILTER (WHERE h = 2) AS \"02h\",\n  count(*) FILTER (WHERE h = 3) AS \"03h\",\n  count(*) FILTER (WHERE h = 4) AS \"04h\",\n  count(*) FILTER (WHERE h = 5) AS \"05h\",\n  count(*) FILTER (WHERE h = 6) AS \"06h\",\n  count(*) FILTER (WHERE h = 7) AS \"07h\",\n  count(*) FILTER (WHERE h = 8) AS \"08h\",\n  count(*) FILTER (WHERE h = 9) AS \"09h\",\n  count(*) FILTER (WHERE h = 10) AS \"10h\",\n  count(*) FILTER (WHERE h = 11) AS \"11h\",\n  count(*) FILTER (WHERE h = 12) AS \"12h\",\n  count(*) FILTER (WHERE h = 13) AS \"13h\",\n  count(*) FILTER (WHERE h = 14) AS \"14h\",\n  count(*) FILTER (WHERE h = 15) AS \"15h\",\n  count(*) FILTER (WHERE h = 16) AS \"16h\",\n  count(*) FILTER (WHERE h = 17) AS \"17h\",\n  count(*) FILTER (WHERE h = 18) AS \"18h\",\n  count(*) FILTER (WHERE h = 19) AS \"19h\",\n  count(*) FILTER (WHERE h = 20) AS \"20h\",\n  count(*) FILTER (WHERE h = 21) AS \"21h\",\n  count(*) FILTER (WHERE h = 22) AS \"22h\",\n  count(*) FILTER (WHERE h = 23) AS \"23h\"\nFROM (SELECT EXTRACT(ISODOW FROM data_abertura AT TIME ZONE 'America/Fortaleza')::int AS d,\n             EXTRACT(HOUR FROM data_abertura AT TIME ZONE 'America/Fortaleza')::int AS h\n      FROM opa_atendimentos WHERE setor IN ($setor) AND $__timeFilter(data_abertura)) x\nGROUP BY d ORDER BY d"
        }
      ],
